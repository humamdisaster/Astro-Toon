  <edges xsi:type="com.yattasolutions.diagrams:ConnectionVisual" xmi:id="_SkVesMcbEfCon5mvN1rsRA" targetItem="_SlA0OccbEfCon5mvN1rsRA" sourceItem="_SkU3oMcbEfCon5mvN1rsRA"/>
  <edges xsi:type="com.yattasolutions.diagrams:ConnectionVisual" xmi:id="_VZ0zMMcdEfCon5mvN1rsRA" targetItem="_SRYtgMcbEfCon5mvN1rsRA" sourceItem="_VZTOwMcdEfCon5mvN1rsRA"/>
  <edges xsi:type="com.yattasolutions.diagrams:ConnectionVisual" xmi:id="_VbGlkMcdEfCon5mvN1rsRA" targetItem="_SRZUlccbEfCon5mvN1rsRA" sourceItem="_Va6YUMcdEfCon5mvN1rsRA"/>
  <edges xsi:type="com.yattasolutions.diagrams:ConnectionVisual" xmi:id="_3mt6UMcdEfCon5mvN1rsRA" targetItem="_SbiIAMcbEfCon5mvN1rsRA" sourceItem="_3mpB0McdEfCon5mvN1rsRA"/>
  <nodes xsi:type="com.yattasolutions.diagrams:CommentVisual" xmi:id="_SADF4McbEfCon5mvN1rsRA" sourceConnectionVisual="_SAHXUMcbEfCon5mvN1rsRA" text="Clase principal del juego.&#xA;Extiende {@link Game} de LibGDX y se encarga de:&#xA;- Inicializar recursos gráficos y fuentes&#xA;- Mantener el puntaje más alto (high score)&#xA;- Establecer la pantalla inicial del juego (menú)" item="_SBPYsMcbEfCon5mvN1rsRA">
    <modelElement href="Game-coreNew.uml#_H14X8McbEfCon5mvN1rsRA"/>
  </nodes>
  <nodes xsi:type="com.yattasolutions.diagrams:CommentVisual" xmi:id="_SAXO8McbEfCon5mvN1rsRA" sourceConnectionVisual="_SAX2AMcbEfCon5mvN1rsRA" text="Inicializa los recursos del juego y establece la pantalla inicial.&#xA;     * Se ejecuta al iniciar la aplicación." item="_SBP_zscbEfCon5mvN1rsRA">
    <modelElement href="Game-coreNew.uml#_H14_AMcbEfCon5mvN1rsRA"/>
  </nodes>
  <nodes xsi:type="com.yattasolutions.diagrams:CommentVisual" xmi:id="_SAZEIMcbEfCon5mvN1rsRA" sourceConnectionVisual="_SAZrMMcbEfCon5mvN1rsRA" text="Renderiza la pantalla actual.&#xA;     * Llama a {@link Game#render()} para actualizar la lógica y dibujado de la pantalla activa." item="_SBP_0ccbEfCon5mvN1rsRA">
    <modelElement href="Game-coreNew.uml#_H15mEMcbEfCon5mvN1rsRA"/>
  </nodes>
  <nodes xsi:type="com.yattasolutions.diagrams:CommentVisual" xmi:id="_SAa5UMcbEfCon5mvN1rsRA" sourceConnectionVisual="_SAbgYMcbEfCon5mvN1rsRA" text="Libera los recursos utilizados por el juego (batch y fuente).&#xA;     * Se ejecuta al cerrar la aplicación." item="_SBP_1McbEfCon5mvN1rsRA">
    <modelElement href="Game-coreNew.uml#_H15mEccbEfCon5mvN1rsRA"/>
  </nodes>
  <nodes xsi:type="com.yattasolutions.diagrams:CommentVisual" xmi:id="_SAoUsMcbEfCon5mvN1rsRA" sourceConnectionVisual="_SAo7wMcbEfCon5mvN1rsRA" text="Obtiene la fuente utilizada para dibujar texto.&#xA;     * @return Fuente activa (BitmapFont)" item="_SBP_18cbEfCon5mvN1rsRA">
    <modelElement href="Game-coreNew.uml#_H16NIMcbEfCon5mvN1rsRA"/>
  </nodes>
  <nodes xsi:type="com.yattasolutions.diagrams:CommentVisual" xmi:id="_SEvYoMcbEfCon5mvN1rsRA" sourceConnectionVisual="_SEwmwMcbEfCon5mvN1rsRA" text="Clase abstracta que representa una nave genérica en el juego, ya sea del jugador o enemiga.&#xA;Implementa {@link Colisionable} y {@link Objetivo}, definiendo la lógica común de:&#xA;- Movimiento&#xA;- Vida y daño&#xA;- Estado de invencibilidad tras recibir daño&#xA;- Colisiones entre naves" item="_SG_bYMcbEfCon5mvN1rsRA">
    <modelElement href="Game-coreNew.uml#_H18pYMcbEfCon5mvN1rsRA"/>
  </nodes>
  <nodes xsi:type="com.yattasolutions.diagrams:CommentVisual" xmi:id="_SEzqEMcbEfCon5mvN1rsRA" sourceConnectionVisual="_SEzqEccbEfCon5mvN1rsRA" text="[CAMBIO GM2.2 - HOOK (GANCHO)]&#xA;     * Este es un &quot;hook&quot; opcional. Es un método con una implementación vacía&#xA;     * que las subclases PUEDEN (pero no están obligadas a) sobrescribir.&#xA;     * En nuestro caso, NaveJugador lo usará para los límites de pantalla." item="_SHACgscbEfCon5mvN1rsRA">
    <modelElement href="Game-coreNew.uml#_H1-ekMcbEfCon5mvN1rsRA"/>
  </nodes>
  <nodes xsi:type="com.yattasolutions.diagrams:CommentVisual" xmi:id="_SE1fQMcbEfCon5mvN1rsRA" sourceConnectionVisual="_SE2GUMcbEfCon5mvN1rsRA" text="Aplica la velocidad actual al sprite para mover la nave." item="_SHAChccbEfCon5mvN1rsRA">
    <modelElement href="Game-coreNew.uml#_H1_FoMcbEfCon5mvN1rsRA"/>
  </nodes>
  <nodes xsi:type="com.yattasolutions.diagrams:CommentVisual" xmi:id="_SE3UcMcbEfCon5mvN1rsRA" sourceConnectionVisual="_SE37gMcbEfCon5mvN1rsRA" text="Actualiza el estado de herido/invencibilidad decrementando el temporizador." item="_SHACiMcbEfCon5mvN1rsRA">
    <modelElement href="Game-coreNew.uml#_H1_FoccbEfCon5mvN1rsRA"/>
  </nodes>
  <nodes xsi:type="com.yattasolutions.diagrams:CommentVisual" xmi:id="_SE9bEMcbEfCon5mvN1rsRA" sourceConnectionVisual="_SE-CIMcbEfCon5mvN1rsRA" text="Método abstracto para aplicar daño.&#xA;     * Forzamos a NaveJugador y NaveEnemiga a implementar su PROPIA&#xA;     * lógica de daño, separando las vidas del jugador (GameManager)&#xA;     * de las vidas del enemigo (variable local).&#xA;     *&#xA;     * @param dano Cantidad de daño a aplicar" item="_SHACi8cbEfCon5mvN1rsRA">
    <modelElement href="Game-coreNew.uml#_H1_ssMcbEfCon5mvN1rsRA"/>
  </nodes>
  <nodes xsi:type="com.yattasolutions.diagrams:CommentVisual" xmi:id="_SFHMEMcbEfCon5mvN1rsRA" sourceConnectionVisual="_SFHzIMcbEfCon5mvN1rsRA" text="Activa el estado de invencibilidad (herido) por una duración específica.&#xA;     * Usado, por ejemplo, por el Power-Up de Escudo.&#xA;     *&#xA;     * @param duracion Número de frames que durará la invencibilidad" item="_SHACmMcbEfCon5mvN1rsRA">
    <modelElement href="Game-coreNew.uml#_H2ATwMcbEfCon5mvN1rsRA"/>
  </nodes>
  <nodes xsi:type="com.yattasolutions.diagrams:CommentVisual" xmi:id="_SFJoUMcbEfCon5mvN1rsRA" sourceConnectionVisual="_SFKPYMcbEfCon5mvN1rsRA" text="Indica si la nave ha sido destruida.&#xA;     * @return true si la nave está destruida, false en caso contrario" item="_SHACnscbEfCon5mvN1rsRA">
    <modelElement href="Game-coreNew.uml#_H2A60McbEfCon5mvN1rsRA"/>
  </nodes>
  <nodes xsi:type="com.yattasolutions.diagrams:CommentVisual" xmi:id="_SFMroMcbEfCon5mvN1rsRA" sourceConnectionVisual="_SFNSsMcbEfCon5mvN1rsRA" text="Indica si la nave está en estado de herido/invencibilidad.&#xA;     * @return true si la nave está herida, false en caso contrario" item="_SHACo8cbEfCon5mvN1rsRA">
    <modelElement href="Game-coreNew.uml#_H2A60ccbEfCon5mvN1rsRA"/>
  </nodes>
  <nodes xsi:type="com.yattasolutions.diagrams:CommentVisual" xmi:id="_SFPH4McbEfCon5mvN1rsRA" sourceConnectionVisual="_SFPu8McbEfCon5mvN1rsRA" text="Obtiene la cantidad de vidas actuales de la nave.&#xA;     * @return Número de vidas restantes" item="_SHACqMcbEfCon5mvN1rsRA">
    <modelElement href="Game-coreNew.uml#_H2Bh4McbEfCon5mvN1rsRA"/>
  </nodes>
  <nodes xsi:type="com.yattasolutions.diagrams:CommentVisual" xmi:id="_SFRkIMcbEfCon5mvN1rsRA" sourceConnectionVisual="_SFSLMMcbEfCon5mvN1rsRA" text="Establece la cantidad de vidas de la nave.&#xA;     * @param vidas Nueva cantidad de vidas" item="_SHACrccbEfCon5mvN1rsRA">
    <modelElement href="Game-coreNew.uml#_H2Bh4ccbEfCon5mvN1rsRA"/>
  </nodes>
  <nodes xsi:type="com.yattasolutions.diagrams:CommentVisual" xmi:id="_SFUAYMcbEfCon5mvN1rsRA" sourceConnectionVisual="_SFUncMcbEfCon5mvN1rsRA" text="Obtiene la posición horizontal de la nave.&#xA;     * @return Coordenada X del sprite" item="_SHACs8cbEfCon5mvN1rsRA">
    <modelElement href="Game-coreNew.uml#_H2CI8McbEfCon5mvN1rsRA"/>
  </nodes>
  <nodes xsi:type="com.yattasolutions.diagrams:CommentVisual" xmi:id="_SFWcoMcbEfCon5mvN1rsRA" sourceConnectionVisual="_SFXDsMcbEfCon5mvN1rsRA" text="Obtiene la posición vertical de la nave.&#xA;     * @return Coordenada Y del sprite" item="_SHACuMcbEfCon5mvN1rsRA">
    <modelElement href="Game-coreNew.uml#_H2CwAMcbEfCon5mvN1rsRA"/>
  </nodes>
  <nodes xsi:type="com.yattasolutions.diagrams:CommentVisual" xmi:id="_SFY44McbEfCon5mvN1rsRA" sourceConnectionVisual="_SFZf8McbEfCon5mvN1rsRA" text="Obtiene la velocidad horizontal de la nave.&#xA;     * @return Velocidad en el eje X" item="_SHACvccbEfCon5mvN1rsRA">
    <modelElement href="Game-coreNew.uml#_H2DXEMcbEfCon5mvN1rsRA"/>
  </nodes>
  <nodes xsi:type="com.yattasolutions.diagrams:CommentVisual" xmi:id="_SFb8MMcbEfCon5mvN1rsRA" sourceConnectionVisual="_SFdKUMcbEfCon5mvN1rsRA" text="Obtiene la velocidad vertical de la nave.&#xA;     * @return Velocidad en el eje Y" item="_SHACwscbEfCon5mvN1rsRA">
    <modelElement href="Game-coreNew.uml#_H2DXEccbEfCon5mvN1rsRA"/>
  </nodes>
  <nodes xsi:type="com.yattasolutions.diagrams:CommentVisual" xmi:id="_SFe_gMcbEfCon5mvN1rsRA" sourceConnectionVisual="_SFe_gccbEfCon5mvN1rsRA" text="Establece la velocidad horizontal de la nave.&#xA;     * @param xVel Nueva velocidad en el eje X" item="_SHACx8cbEfCon5mvN1rsRA">
    <modelElement href="Game-coreNew.uml#_H2D-IMcbEfCon5mvN1rsRA"/>
  </nodes>
  <nodes xsi:type="com.yattasolutions.diagrams:CommentVisual" xmi:id="_SFg0sMcbEfCon5mvN1rsRA" sourceConnectionVisual="_SFhbwMcbEfCon5mvN1rsRA" text="Establece la velocidad vertical de la nave.&#xA;     * @param yVel Nueva velocidad en el eje Y" item="_SHApg8cbEfCon5mvN1rsRA">
    <modelElement href="Game-coreNew.uml#_H2ElMMcbEfCon5mvN1rsRA"/>
  </nodes>
  <nodes xsi:type="com.yattasolutions.diagrams:CommentVisual" xmi:id="_SFlGIMcbEfCon5mvN1rsRA" sourceConnectionVisual="_SFltMMcbEfCon5mvN1rsRA" text="[CAMBIO GM2.2 - EL TEMPLATE METHOD]&#xA;     * Este es el &quot;Template Method&quot;. Es final, lo que significa que las subclases&#xA;     * no pueden sobrescribirlo. Define el esqueleto del algoritmo de actualización.&#xA;     * * @param juego Instancia de {@link PantallaJuego} para acceder al estado del juego" item="_SHApk8cbEfCon5mvN1rsRA">
    <modelElement href="Game-coreNew.uml#_H19QcccbEfCon5mvN1rsRA"/>
  </nodes>
  <nodes xsi:type="com.yattasolutions.diagrams:CommentVisual" xmi:id="_SFniYMcbEfCon5mvN1rsRA" sourceConnectionVisual="_SFoJcMcbEfCon5mvN1rsRA" text="[CAMBIO GM2.2 - PASO ABSTRACTO]&#xA;     * Este es el paso abstracto que las subclases (NaveJugador, NaveEnemiga)&#xA;     * DEBEN implementar para definir su comportamiento (Input o IA).&#xA;     * Reemplaza al antiguo 'abstract void update()'.&#xA;     *&#xA;     * @param juego Instancia de {@link PantallaJuego}" item="_SHApmccbEfCon5mvN1rsRA">
    <modelElement href="Game-coreNew.uml#_H193gMcbEfCon5mvN1rsRA"/>
  </nodes>
  <nodes xsi:type="com.yattasolutions.diagrams:CommentVisual" xmi:id="_SFveMMcbEfCon5mvN1rsRA" sourceConnectionVisual="_SFwFQMcbEfCon5mvN1rsRA" text="Constructor de la nave.&#xA;     * Inicializa el sprite, la posición y la cantidad de vidas.&#xA;     *&#xA;     * @param tx Textura de la nave&#xA;     * @param x Posición horizontal inicial&#xA;     * @param y Posición vertical inicial&#xA;     * @param vidas Cantidad de vidas iniciales" item="_SHApsccbEfCon5mvN1rsRA">
    <modelElement href="Game-coreNew.uml#_H19QcMcbEfCon5mvN1rsRA"/>
  </nodes>
  <nodes xsi:type="com.yattasolutions.diagrams:CommentVisual" xmi:id="_SF0WsMcbEfCon5mvN1rsRA" sourceConnectionVisual="_SF0WsccbEfCon5mvN1rsRA" text="Dibuja la nave en pantalla.&#xA;     * Aplica un efecto de &quot;parpadeo&quot; cuando la nave está herida.&#xA;     *&#xA;     * @param batch SpriteBatch usado para el renderizado" item="_SHApwMcbEfCon5mvN1rsRA">
    <modelElement href="Game-coreNew.uml#_H1-ekccbEfCon5mvN1rsRA"/>
  </nodes>
  <nodes xsi:type="com.yattasolutions.diagrams:CommentVisual" xmi:id="_SJze0McbEfCon5mvN1rsRA" sourceConnectionVisual="_SJ0F4McbEfCon5mvN1rsRA" text="Representa un objeto de {@code Power-Up} que aparece en la pantalla&#xA;y puede ser recogido por el jugador para obtener beneficios.&#xA;&lt;p>&#xA;Los Power-Ups se desplazan lentamente hacia la izquierda y desaparecen&#xA;al salir del área visible o al ser recogidos por la nave del jugador.&#xA;&lt;/p>&#xA; *&#xA;@see TipoPowerUp&#xA;@see NaveJugador&#xA;@see Colisionable" item="_SKYGkMcbEfCon5mvN1rsRA">
    <modelElement href="Game-coreNew.uml#_H2HogMcbEfCon5mvN1rsRA"/>
  </nodes>
  <nodes xsi:type="com.yattasolutions.diagrams:CommentVisual" xmi:id="_SJ3JMMcbEfCon5mvN1rsRA" sourceConnectionVisual="_SJ3wQMcbEfCon5mvN1rsRA" text="Actualiza el estado del power-up en cada frame.&#xA;     * &lt;p>&#xA;     * Controla su desplazamiento y verifica si debe ser eliminado&#xA;     * al salir del área visible de la pantalla.&#xA;     * &lt;/p>" item="_SKYttccbEfCon5mvN1rsRA">
    <modelElement href="Game-coreNew.uml#_H2IPkccbEfCon5mvN1rsRA"/>
  </nodes>
  <nodes xsi:type="com.yattasolutions.diagrams:CommentVisual" xmi:id="_SJ5lcMcbEfCon5mvN1rsRA" sourceConnectionVisual="_SJ6MgMcbEfCon5mvN1rsRA" text="Indica si el power-up debe eliminarse del juego.&#xA;     *&#xA;     * @return {@code true} si el power-up ha sido destruido,&#xA;     *         {@code false} en caso contrario." item="_SKYtuMcbEfCon5mvN1rsRA">
    <modelElement href="Game-coreNew.uml#_H2I2occbEfCon5mvN1rsRA"/>
  </nodes>
  <nodes xsi:type="com.yattasolutions.diagrams:CommentVisual" xmi:id="_SKCvYMcbEfCon5mvN1rsRA" sourceConnectionVisual="_SKCvYccbEfCon5mvN1rsRA" text="Constructor para el Power-Up.&#xA;     * @param x Posición inicial en x.&#xA;     * @param y Posición inicial en y.&#xA;     * @param tx Textura del power-up.&#xA;     * @param tipo El tipo de power-up (VIDA o ESCUDO)." item="_SKYt1scbEfCon5mvN1rsRA">
    <modelElement href="Game-coreNew.uml#_H2IPkMcbEfCon5mvN1rsRA"/>
  </nodes>
  <nodes xsi:type="com.yattasolutions.diagrams:CommentVisual" xmi:id="_SKFLoMcbEfCon5mvN1rsRA" sourceConnectionVisual="_SKFLoccbEfCon5mvN1rsRA" text="Dibuja el power-up en la pantalla.&#xA;     * @param batch El SpriteBatch para dibujar." item="_SKYt6McbEfCon5mvN1rsRA">
    <modelElement href="Game-coreNew.uml#_H2I2oMcbEfCon5mvN1rsRA"/>
  </nodes>
  <nodes xsi:type="com.yattasolutions.diagrams:CommentVisual" xmi:id="_SLe50McbEfCon5mvN1rsRA" sourceConnectionVisual="_SLfg4McbEfCon5mvN1rsRA" text="Clase que representa la nave controlada por el jugador.&#xA;Hereda de {@link NaveBase} y gestiona el input del teclado para moverse y disparar.&#xA;Además maneja efectos de sonido al recibir daño, disparar o recolectar power-ups.&#xA;[CAMBIO GM2.3 - PATRÓN STRATEGY (Contexto)]&#xA;Esta clase ahora actúa como el &quot;Contexto&quot; del patrón Strategy.&#xA;Delega la lógica de disparo a un objeto IDisparoStrategy." item="_SMdKMMcbEfCon5mvN1rsRA">
    <modelElement href="Game-coreNew.uml#_H2FzUMcbEfCon5mvN1rsRA"/>
  </nodes>
  <nodes xsi:type="com.yattasolutions.diagrams:CommentVisual" xmi:id="_SLoDwMcbEfCon5mvN1rsRA" sourceConnectionVisual="_SLoq0McbEfCon5mvN1rsRA" text="Libera los recursos de sonido utilizados por la nave." item="_SMdxQ8cbEfCon5mvN1rsRA">
    <modelElement href="Game-coreNew.uml#_H2HBcccbEfCon5mvN1rsRA"/>
  </nodes>
  <nodes xsi:type="com.yattasolutions.diagrams:CommentVisual" xmi:id="_SLwmoMcbEfCon5mvN1rsRA" sourceConnectionVisual="_SLxNsMcbEfCon5mvN1rsRA" text="Procesa el efecto de un power-up recolectado.&#xA;     * - VIDA: [CAMBIO GM2.1] Llama al GameManager para sumar vidas.&#xA;     * - ESCUDO: activa invencibilidad temporal&#xA;     * [CAMBIO GM2.3] Añade el caso para DISPARO_DOBLE.&#xA;     *&#xA;     * @param tipo El {@link TipoPowerUp} que se recogió" item="_SMdxVscbEfCon5mvN1rsRA">
    <modelElement href="Game-coreNew.uml#_H2HBcMcbEfCon5mvN1rsRA"/>
  </nodes>
  <nodes xsi:type="com.yattasolutions.diagrams:CommentVisual" xmi:id="_SL0RAMcbEfCon5mvN1rsRA" sourceConnectionVisual="_SL04EMcbEfCon5mvN1rsRA" text="Constructor de la nave del jugador.&#xA;     * Inicializa la textura, posición, vidas y los sonidos.&#xA;     *&#xA;     *[CAMBIO GM2.3] Inicializa la estrategia de disparo por defecto.&#xA;     *&#xA;     * @param x Posición horizontal inicial&#xA;     * @param y Posición vertical inicial&#xA;     * @param tx Textura de la nave&#xA;     * @param txBala Textura de las balas disparadas" item="_SMdxXMcbEfCon5mvN1rsRA">
    <modelElement href="Game-coreNew.uml#_H2GaYMcbEfCon5mvN1rsRA"/>
  </nodes>
  <nodes xsi:type="com.yattasolutions.diagrams:CommentVisual" xmi:id="_SPUQ8McbEfCon5mvN1rsRA" sourceConnectionVisual="_SPU4AMcbEfCon5mvN1rsRA" text="Representa un proyectil disparado en el juego.&#xA;Implementa la interfaz {@link Colisionable} para poder interactuar&#xA;con otros objetos que puedan colisionar.&#xA;La bala se mueve según una velocidad definida en X e Y, y se destruye&#xA;al salir del área del mundo o al impactar un objeto colisionable." item="_SQG7IMcbEfCon5mvN1rsRA">
    <modelElement href="Game-coreNew.uml#_H160MMcbEfCon5mvN1rsRA"/>
  </nodes>
  <nodes xsi:type="com.yattasolutions.diagrams:CommentVisual" xmi:id="_SPXUQMcbEfCon5mvN1rsRA" sourceConnectionVisual="_SPX7UMcbEfCon5mvN1rsRA" text="Actualiza la posición de la bala según su velocidad.&#xA;     * Marca la bala como destruida si sale del área del mundo." item="_SQG7NscbEfCon5mvN1rsRA">
    <modelElement href="Game-coreNew.uml#_H17bQccbEfCon5mvN1rsRA"/>
  </nodes>
  <nodes xsi:type="com.yattasolutions.diagrams:CommentVisual" xmi:id="_SPiTYMcbEfCon5mvN1rsRA" sourceConnectionVisual="_SPiTYccbEfCon5mvN1rsRA" text="Crea una nueva bala en la posición dada con la velocidad y textura especificadas.&#xA;     * @param x Posición horizontal inicial&#xA;     * @param y Posición vertical inicial&#xA;     * @param xSpeed Velocidad horizontal de la bala&#xA;     * @param ySpeed Velocidad vertical de la bala&#xA;     * @param tx Textura que representa la bala" item="_SQG7UscbEfCon5mvN1rsRA">
    <modelElement href="Game-coreNew.uml#_H17bQMcbEfCon5mvN1rsRA"/>
  </nodes>
  <nodes xsi:type="com.yattasolutions.diagrams:CommentVisual" xmi:id="_SPkIkMcbEfCon5mvN1rsRA" sourceConnectionVisual="_SPkvoMcbEfCon5mvN1rsRA" text="Dibuja la bala en pantalla usando el SpriteBatch proporcionado.&#xA;     * @param batch SpriteBatch utilizado para el renderizado" item="_SQG7Z8cbEfCon5mvN1rsRA">
    <modelElement href="Game-coreNew.uml#_H18CUMcbEfCon5mvN1rsRA"/>
  </nodes>
  <nodes xsi:type="com.yattasolutions.diagrams:CommentVisual" xmi:id="_SR2AgMcbEfCon5mvN1rsRA" sourceConnectionVisual="_SR2AgccbEfCon5mvN1rsRA" text="[CLASE GM2.3 - PATRÓN STRATEGY (Interfaz)]&#xA;Interfaz que define el &quot;esqueleto&quot; de un algoritmo de disparo.&#xA;Cualquier comportamiento de disparo (simple, doble, láser, etc.)&#xA;debe implementar esta interfaz." item="_SR65AMcbEfCon5mvN1rsRA">
    <modelElement href="Game-coreNew.uml#_H2KEwMcbEfCon5mvN1rsRA"/>
  </nodes>
  <nodes xsi:type="com.yattasolutions.diagrams:CommentVisual" xmi:id="_SS4iUMcbEfCon5mvN1rsRA" sourceConnectionVisual="_SS5JYMcbEfCon5mvN1rsRA" text="[CLASE GM2.3 - PATRÓN STRATEGY (Estrategia Concreta)]&#xA;Implementación de la estrategia de disparo doble.&#xA;Crea dos balas en lugar de una." item="_STAeIMcbEfCon5mvN1rsRA">
    <modelElement href="Game-coreNew.uml#_H2JdsMcbEfCon5mvN1rsRA"/>
  </nodes>
  <nodes xsi:type="com.yattasolutions.diagrams:CommentVisual" xmi:id="_STUAIMcbEfCon5mvN1rsRA" sourceConnectionVisual="_STUnMMcbEfCon5mvN1rsRA" text="[CLASE GM2.3 - PATRÓN STRATEGY (Estrategia Concreta)]&#xA;Implementación de la estrategia de disparo simple.&#xA;Esta es la lógica original que estaba en NaveJugador." item="_STdxIMcbEfCon5mvN1rsRA">
    <modelElement href="Game-coreNew.uml#_H2JdsccbEfCon5mvN1rsRA"/>
  </nodes>
  <nodes xsi:type="com.yattasolutions.diagrams:CommentVisual" xmi:id="_SZ2tAMcbEfCon5mvN1rsRA" sourceConnectionVisual="_SZ37IMcbEfCon5mvN1rsRA" text="Clase responsable de gestionar las rondas del juego.&#xA;Controla las condiciones de victoria y &#xA;gestiona las transiciones correspondientes entre pantallas.&#xA;* [CAMBIO GM2.1] La lógica de derrota (nave.estaDestruido())&#xA;se ha movido a PantallaJuego.render(). Este gestor&#xA;ahora solo se enfoca en la condición de victoria (completar ronda)." item="_SaDhUMcbEfCon5mvN1rsRA">
    <modelElement href="Game-coreNew.uml#_H2SAkMcbEfCon5mvN1rsRA"/>
  </nodes>
  <nodes xsi:type="com.yattasolutions.diagrams:CommentVisual" xmi:id="_SaQ8sMcbEfCon5mvN1rsRA" sourceConnectionVisual="_SaRjwMcbEfCon5mvN1rsRA" text="[CLASE GM2.1 - PATRÓN SINGLETON]&#xA;* Esta clase implementa el patrón de diseño Singleton.&#xA;Se encarga de gestionar el estado global del juego, como el puntaje y las vidas,&#xA;asegurando que solo exista UNA instancia de este gestor en toda la aplicación.&#xA;* El acceso se realiza a través del método estático `GameManager.getInstance()`." item="_SagNQMcbEfCon5mvN1rsRA">
    <modelElement href="Game-coreNew.uml#_H2QLYMcbEfCon5mvN1rsRA"/>
  </nodes>
  <nodes xsi:type="com.yattasolutions.diagrams:CommentVisual" xmi:id="_SbMJwMcbEfCon5mvN1rsRA" sourceConnectionVisual="_SbMw0McbEfCon5mvN1rsRA" text="Clase responsable de gestionar todas las colisiones entre los objetos&#xA;del juego, incluyendo jugador, enemigos, balas y power-ups.&#xA;Se encarga de detectar colisiones y aplicar las consecuencias correspondientes,&#xA;como daño, destrucción de objetos, incremento de puntuación o activación de efectos." item="_SbXI4McbEfCon5mvN1rsRA">
    <modelElement href="Game-coreNew.uml#_H2RZgMcbEfCon5mvN1rsRA"/>
  </nodes>
  <nodes xsi:type="com.yattasolutions.diagrams:CommentVisual" xmi:id="_ScKaIMcbEfCon5mvN1rsRA" sourceConnectionVisual="_ScLBMMcbEfCon5mvN1rsRA" text="Interfaz que define un objetivo dentro del juego.&#xA;Cualquier clase que pueda ser objetivo de otras entidades (por ejemplo, enemigos)&#xA;debe implementar esta interfaz para proporcionar su posición y estado de vida." item="_ScVZQMcbEfCon5mvN1rsRA">
    <modelElement href="Game-coreNew.uml#_H2SnoMcbEfCon5mvN1rsRA"/>
  </nodes>
  <nodes xsi:type="com.yattasolutions.diagrams:CommentVisual" xmi:id="_ScOEgMcbEfCon5mvN1rsRA" sourceConnectionVisual="_ScOrkMcbEfCon5mvN1rsRA" text="Obtiene la coordenada horizontal (X) del objetivo.&#xA;     * @return Posición X" item="_ScVZR8cbEfCon5mvN1rsRA">
    <modelElement href="Game-coreNew.uml#_H2SnoccbEfCon5mvN1rsRA"/>
  </nodes>
  <nodes xsi:type="com.yattasolutions.diagrams:CommentVisual" xmi:id="_ScP5sMcbEfCon5mvN1rsRA" sourceConnectionVisual="_ScQgwMcbEfCon5mvN1rsRA" text="Indica si el objetivo ha sido destruido.&#xA;     * @return true si el objetivo está destruido, false en caso contrario" item="_ScVZTMcbEfCon5mvN1rsRA">
    <modelElement href="Game-coreNew.uml#_H2k7gMcbEfCon5mvN1rsRA"/>
  </nodes>
  <nodes xsi:type="com.yattasolutions.diagrams:CommentVisual" xmi:id="_Sc7PIMcbEfCon5mvN1rsRA" sourceConnectionVisual="_Sc72MMcbEfCon5mvN1rsRA" text="Pantalla principal del juego. Se encarga de la lógica general,&#xA;incluyendo renderizado, control de entidades, detección de colisiones,&#xA;administración de rondas y actualización del estado del juego.&#xA; *&#xA;&lt;p>Esta clase implementa {@link Screen} y funciona como el núcleo&#xA;donde se combinan los diferentes sistemas del juego, como el&#xA;{@link GestorColisiones} y el {@link GestorRondas}.&lt;/p>&#xA;[CAMBIO GM2.1] Esta clase ya no almacena 'score' ni 'vidas'.&#xA;Ahora consulta al GameManager (Singleton) para obtener esa información.&#xA;[CAMBIO GM2.3] Carga y suelta el nuevo PowerUp de Disparo Doble." item="_Sf4cgMcbEfCon5mvN1rsRA">
    <modelElement href="Game-coreNew.uml#_H2mwsMcbEfCon5mvN1rsRA"/>
  </nodes>
  <nodes xsi:type="com.yattasolutions.diagrams:CommentVisual" xmi:id="_SdM78McbEfCon5mvN1rsRA" sourceConnectionVisual="_SdNjAMcbEfCon5mvN1rsRA" text="Dibuja la interfaz del jugador (HUD).&#xA;     * [CAMBIO GM2.1] Lee 'vidas' y 'score' directamente del GameManager." item="_Sf5D_scbEfCon5mvN1rsRA">
    <modelElement href="Game-coreNew.uml#_H2n-0McbEfCon5mvN1rsRA"/>
  </nodes>
  <nodes xsi:type="com.yattasolutions.diagrams:CommentVisual" xmi:id="_SdQmUMcbEfCon5mvN1rsRA" sourceConnectionVisual="_SdRNYMcbEfCon5mvN1rsRA" text="Incrementa la puntuación del jugador.&#xA;     * [CAMBIO GM2.1] Llama al GameManager para añadir el score.&#xA;     * @param cantidad puntos a añadir al marcador actual." item="_Sf5EEccbEfCon5mvN1rsRA">
    <modelElement href="Game-coreNew.uml#_H2n-0ccbEfCon5mvN1rsRA"/>
  </nodes>
  <nodes xsi:type="com.yattasolutions.diagrams:CommentVisual" xmi:id="_SdTCkMcbEfCon5mvN1rsRA" sourceConnectionVisual="_SdTCkccbEfCon5mvN1rsRA" text="Genera un Power-Up en una posición determinada tras la destrucción de un enemigo.&#xA;     * [CAMBIO GM2.3] Ahora puede soltar uno de los tres tipos de PowerUp.&#xA;     * @param x posición X donde aparece el Power-Up.&#xA;     * @param y posición Y donde aparece el Power-Up." item="_Sf5EF8cbEfCon5mvN1rsRA">
    <modelElement href="Game-coreNew.uml#_H2ol4McbEfCon5mvN1rsRA"/>
  </nodes>
  <nodes xsi:type="com.yattasolutions.diagrams:CommentVisual" xmi:id="_SdZwQMcbEfCon5mvN1rsRA" sourceConnectionVisual="_SdaXUMcbEfCon5mvN1rsRA" text="Constructor principal. Inicializa los recursos y entidades necesarias&#xA;     * para comenzar la ronda.&#xA;     *&#xA;     * [CAMBIO GM2.3] Carga la textura para el nuevo power-up.&#xA;     *&#xA;     * @param game referencia al juego principal.&#xA;     * @param ronda número actual de la ronda.&#xA;     * @param cantEnemigos cantidad de enemigos que aparecerán en la ronda." item="_Sf5qtscbEfCon5mvN1rsRA">
    <modelElement href="Game-coreNew.uml#_H2nXwMcbEfCon5mvN1rsRA"/>
  </nodes>
  <nodes xsi:type="com.yattasolutions.diagrams:CommentVisual" xmi:id="_SdcMgMcbEfCon5mvN1rsRA" sourceConnectionVisual="_SdczkMcbEfCon5mvN1rsRA" text="Permite a otras clases (como NaveJugador) añadir balas a la lista.&#xA;     * @param bb La bala a añadir.&#xA;     * @return true si la bala fue añadida." item="_Sf5qyMcbEfCon5mvN1rsRA">
    <modelElement href="Game-coreNew.uml#_H2ol4ccbEfCon5mvN1rsRA"/>
  </nodes>
  <nodes xsi:type="com.yattasolutions.diagrams:CommentVisual" xmi:id="_Sihg0McbEfCon5mvN1rsRA" sourceConnectionVisual="_SiiH4McbEfCon5mvN1rsRA" text="Representa la pantalla inicial o menú principal del juego {@code Space Navigation}.&#xA;&lt;p>&#xA;Esta pantalla muestra una imagen de fondo y reproduce música mientras&#xA;el jugador espera para iniciar la partida. Al hacer clic o presionar cualquier tecla,&#xA;se inicia la primera ronda del juego.&#xA;&lt;/p>&#xA; *&#xA;@see PantallaJuego&#xA;@see SpaceNavigation" item="_SjcG0McbEfCon5mvN1rsRA">
    <modelElement href="Game-coreNew.uml#_H2pM8McbEfCon5mvN1rsRA"/>
  </nodes>
  <nodes xsi:type="com.yattasolutions.diagrams:CommentVisual" xmi:id="_Si57UMcbEfCon5mvN1rsRA" sourceConnectionVisual="_Si6iYMcbEfCon5mvN1rsRA" text="Crea una nueva instancia de la pantalla de menú principal.&#xA;     *&#xA;     * @param game instancia principal del juego {@link SpaceNavigation}." item="_SjcHE8cbEfCon5mvN1rsRA">
    <modelElement href="Game-coreNew.uml#_H2p0AMcbEfCon5mvN1rsRA"/>
  </nodes>
  <nodes xsi:type="com.yattasolutions.diagrams:CommentVisual" xmi:id="_SkIqYMcbEfCon5mvN1rsRA" sourceConnectionVisual="_SkJRcMcbEfCon5mvN1rsRA" text="Pantalla que se muestra cuando el jugador pierde el juego.&#xA;Muestra un fondo de &quot;Game Over&quot;, reproduce música y permite reiniciar el juego&#xA;al tocar la pantalla o presionar cualquier tecla.&#xA;[CAMBIO GM2.1] Ahora también muestra el puntaje final y el HighScore&#xA;leyendo la información desde el GameManager (Singleton)." item="_SlANEMcbEfCon5mvN1rsRA">
    <modelElement href="Game-coreNew.uml#_H2likMcbEfCon5mvN1rsRA"/>
  </nodes>
  <nodes xsi:type="com.yattasolutions.diagrams:CommentVisual" xmi:id="_SkU3oMcbEfCon5mvN1rsRA" sourceConnectionVisual="_SkVesMcbEfCon5mvN1rsRA" text="Constructor de la pantalla de Game Over.&#xA;     * Inicializa cámara, textura de fondo y música.&#xA;     * [CAMBIO GM2.1] Obtiene el score final desde el GameManager&#xA;     * y actualiza el HighScore si es necesario.&#xA;     * @param game Instancia del juego principal" item="_SlA0OccbEfCon5mvN1rsRA">
    <modelElement href="Game-coreNew.uml#_H2mJoMcbEfCon5mvN1rsRA"/>
  </nodes>
