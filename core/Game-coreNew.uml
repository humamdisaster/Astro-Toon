              </ownedOperation>
              <ownedOperation xmi:id="_GiLUYMcbEfCon5mvN1rsRA" name="incrementarScore" method="_H1kO4McbEfCon5mvN1rsRA">
                <ownedComment xmi:id="_H2n-0ccbEfCon5mvN1rsRA">
                  <body>Incrementa la puntuación del jugador.
     * [CAMBIO GM2.1] Llama al GameManager para añadir el score.
     * @param cantidad puntos a añadir al marcador actual.</body>
                </ownedComment>
                <ownedParameter xmi:id="_GiLUYccbEfCon5mvN1rsRA" name="cantidad">
