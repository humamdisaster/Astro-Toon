              <ownedComment xmi:id="_3V5QEMcdEfCon5mvN1rsRA">
                <body>Define un objeto que puede interactuar (colisionar) con otros objetos.</body>
              </ownedComment>
              <ownedAttribute xmi:id="_GfdXkMcbEfCon5mvN1rsRA" name="area" type="_HauF8McbEfCon5mvN1rsRA" isReadOnly="true" association="_H4V2EMcbEfCon5mvN1rsRA"/>
              <ownedOperation xmi:id="_Hi2HMMcbEfCon5mvN1rsRA" name="colisionaCon">
