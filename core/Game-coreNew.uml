  <uml:OpaqueBehavior xmi:id="_H1KmQMcbEfCon5mvN1rsRA" name="getInstance" specification="_HsytYMcbEfCon5mvN1rsRA">
    <ownedParameter xmi:id="_H1KmQccbEfCon5mvN1rsRA" type="_Gecq8McbEfCon5mvN1rsRA" direction="return"/>
    <language>java</language>
    <body>if (instance == null) {
         // Si es nulo, entramos en un bloque sincronizado para evitar
         // que dos hilos creen la instancia al mismo tiempo.
         synchronized (GameManager.class) {
             // Segundo chequeo (dentro del bloqueo)
             if (instance == null) {
                 // Si aún es nulo, creamos la instancia
                 instance = new GameManager();
             }
         }
     }
     // Devuelve la instancia (la nueva o la que ya existía)
     return instance;
 </body>
  </uml:OpaqueBehavior>
