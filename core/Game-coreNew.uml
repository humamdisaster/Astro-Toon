                </ownedParameter>
                <ownedParameter xmi:id="_H0AIo8cbEfCon5mvN1rsRA" name="tx" type="_Hak8AMcbEfCon5mvN1rsRA"/>
                <ownedParameter xmi:id="_H0AIpMcbEfCon5mvN1rsRA" name="tipo" type="_GliKYMcbEfCon5mvN1rsRA"/>
                <ownedParameter xmi:id="_H0AIpccbEfCon5mvN1rsRA" type="_GU0N0McbEfCon5mvN1rsRA" direction="return"/>
                <language>java</language>
                <body>this.tipo = tipo;
     spr = new Sprite(tx);
     spr.setBounds(x, y, 60, 60);
 </body>
              </ownedBehavior>
              <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_H0AvsMcbEfCon5mvN1rsRA" name="update" specification="_GU_0AMcbEfCon5mvN1rsRA">
                <language>java</language>
                <body>spr.setPosition(spr.getX() + xVel, spr.getY());

     if (spr.getX() + spr.getWidth() &lt; 0) {
         destroyed = true;
     }
 </body>
              </ownedBehavior>
