              <ownedOperation xmi:id="_Hj-IkMcbEfCon5mvN1rsRA" name="PantallaJuego" method="_H1f9cMcbEfCon5mvN1rsRA">
                <eAnnotations xmi:id="_Hj_9wMcbEfCon5mvN1rsRA" source="http://www.eclipse.org/uml2/2.0.0/UML">
                  <details xmi:id="_Hj_9wccbEfCon5mvN1rsRA" key="create"/>
