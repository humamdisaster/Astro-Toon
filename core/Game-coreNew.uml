     * @return true si el objetivo está destruido, false en caso contrario</body>
                </ownedComment>
                <ownedParameter xmi:id="_GfxgoMcbEfCon5mvN1rsRA" direction="return">
                  <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/JavaPrimitiveTypes.library.uml#boolean"/>
                </ownedParameter>
              </ownedOperation>
