              <ownedOperation xmi:id="_GQnqUMcbEfCon5mvN1rsRA" name="actualizarEstadoHerido" visibility="protected" method="_HzZEoMcbEfCon5mvN1rsRA">
                <ownedComment xmi:id="_H1_FoccbEfCon5mvN1rsRA">
