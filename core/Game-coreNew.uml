              <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_H0ROYMcbEfCon5mvN1rsRA" name="disparar" specification="_HnmEUMcbEfCon5mvN1rsRA">
                <ownedParameter xmi:id="_H0ROYccbEfCon5mvN1rsRA" name="nave" type="_GTQHkMcbEfCon5mvN1rsRA"/>
                <ownedParameter xmi:id="_H0ROYscbEfCon5mvN1rsRA" name="txBala" type="_Hak8AMcbEfCon5mvN1rsRA"/>
                <ownedParameter xmi:id="_H0ROY8cbEfCon5mvN1rsRA" name="juego" type="_GhbGcMcbEfCon5mvN1rsRA"/>
                <language>java</language>
                <body>float x = nave.getX() + nave.getAncho() - 5;
     float yCentro = nave.getY() + nave.getAlto() / 2 - 5;

     Bullet bala1 = new Bullet(x, yCentro + 10, 3, 0, txBala);
     Bullet bala2 = new Bullet(x, yCentro - 10, 3, 0, txBala);

     juego.agregarBala(bala1);
     juego.agregarBala(bala2);
 </body>
              </ownedBehavior>
