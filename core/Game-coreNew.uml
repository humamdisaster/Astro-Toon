              <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_H0AIoMcbEfCon5mvN1rsRA" name="PowerUp" specification="_HnaeIMcbEfCon5mvN1rsRA">
                <ownedParameter xmi:id="_H0AIoccbEfCon5mvN1rsRA" name="x">
