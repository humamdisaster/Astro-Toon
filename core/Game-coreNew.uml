              <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_HzSW8McbEfCon5mvN1rsRA" name="colisionaCon" specification="_HdtIgMcbEfCon5mvN1rsRA">
                <ownedParameter xmi:id="_HzSW8ccbEfCon5mvN1rsRA" name="otro" type="_GfaUQMcbEfCon5mvN1rsRA"/>
                <ownedParameter xmi:id="_HzSW8scbEfCon5mvN1rsRA" direction="return">
                  <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/JavaPrimitiveTypes.library.uml#boolean"/>
                </ownedParameter>
                <language>java</language>
                <body>if (otro instanceof NaveEnemiga) {
         NaveEnemiga enemigo = (NaveEnemiga) otro; 
         return this.getArea().overlaps(enemigo.getArea());
     }
     return false;
 </body>
