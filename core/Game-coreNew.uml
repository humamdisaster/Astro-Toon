                </ownedParameter>
                <ownedParameter xmi:id="_HkCaAMcbEfCon5mvN1rsRA" type="_GWWe4McbEfCon5mvN1rsRA" direction="return"/>
              </ownedOperation>
              <ownedOperation xmi:id="_GiDYkMcbEfCon5mvN1rsRA" name="render" method="_H1jAwMcbEfCon5mvN1rsRA">
                <ownedParameter xmi:id="_GiD_oMcbEfCon5mvN1rsRA" name="delta">
