                <ownedParameter xmi:id="_Hi5xkMcbEfCon5mvN1rsRA" name="otro" type="_GfaUQMcbEfCon5mvN1rsRA"/>
              </ownedOperation>
            </packagedElement>
            <packagedElement xmi:type="uml:Interface" xmi:id="_GfqL4McbEfCon5mvN1rsRA" name="Objetivo">
              <ownedComment xmi:id="_H2SnoMcbEfCon5mvN1rsRA">
                <body>Interfaz que define un objetivo dentro del juego.
Cualquier clase que pueda ser objetivo de otras entidades (por ejemplo, enemigos)
debe implementar esta interfaz para proporcionar su posición y estado de vida.</body>
              </ownedComment>
              <ownedAttribute xmi:id="_GfudUMcbEfCon5mvN1rsRA" name="y" isReadOnly="true">
                <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/JavaPrimitiveTypes.library.uml#float"/>
              </ownedAttribute>
              <ownedOperation xmi:id="_GfsoIMcbEfCon5mvN1rsRA" name="getX">
                <ownedComment xmi:id="_H2SnoccbEfCon5mvN1rsRA">
                  <body>Obtiene la coordenada horizontal (X) del objetivo.
     * @return Posición X</body>
                </ownedComment>
                <ownedParameter xmi:id="_GftPMMcbEfCon5mvN1rsRA" direction="return">
                  <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/JavaPrimitiveTypes.library.uml#float"/>
                </ownedParameter>
              </ownedOperation>
              <ownedOperation xmi:id="_GfwSgMcbEfCon5mvN1rsRA" name="estaDestruido">
                <ownedComment xmi:id="_H2k7gMcbEfCon5mvN1rsRA">
