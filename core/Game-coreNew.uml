              <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_HzS-AMcbEfCon5mvN1rsRA" name="alColisionar" specification="_Hdz2MMcbEfCon5mvN1rsRA">
                <ownedParameter xmi:id="_HzS-AccbEfCon5mvN1rsRA" name="otro" type="_GfaUQMcbEfCon5mvN1rsRA"/>
                <language>java</language>
                <body>this.destroyed = true; 
     
     if (otro instanceof NaveEnemiga) {
         NaveEnemiga enemigo = (NaveEnemiga) otro; 
         enemigo.recibirDano(1); 
     }
 </body>
              </ownedBehavior>
