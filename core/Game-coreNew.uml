                <body>// Inicializamos los valores por defecto al crear la instancia
     this.score = 0;
     this.lives = 3; // O las vidas con las que inicie tu jugador
 </body>
              </ownedBehavior>
              <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_H1MbcMcbEfCon5mvN1rsRA" name="addScore" specification="_GenqEMcbEfCon5mvN1rsRA">
